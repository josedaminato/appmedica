# Local development template only. Replace placeholders in your ignored .env file.
# Never commit filled-in credentials or production secrets.

# Database
POSTGRES_USER=appmedica
POSTGRES_PASSWORD=replace-with-local-database-password
POSTGRES_DB=appmedica
DATABASE_URL=postgresql+psycopg://appmedica:replace-with-local-database-password@db:5432/appmedica

# Backend
JWT_SECRET=replace-with-a-long-random-local-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ENV=development
LOG_LEVEL=INFO

# Frontend (Vite)
VITE_API_URL=http://localhost:8000/api/v1

# Development server
UVICORN_RELOAD=0
BACKEND_HOST_PORT=8000

# Reminders
REMINDERS_ENABLED=true
REMINDER_HOURS_BEFORE=24
REMINDER_BACKGROUND_LOOP=true
EMAIL_PROVIDER=mock
WHATSAPP_PROVIDER=disabled
PUBLIC_APP_URL=http://localhost:5173

# Internal operations account for local development
PLATFORM_ADMIN_USERNAME=your-local-admin-user
PLATFORM_ADMIN_PASSWORD=replace-with-a-local-admin-password
